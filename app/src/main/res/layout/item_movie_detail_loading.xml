<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".MovieDetailActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:background="@android:color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/light_gray" />

                <androidx.appcompat.widget.Toolbar
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize">

                    <View
                        android:id="@+id/backBtnLoading"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="16dp"
                        android:background="@color/light_gray" />

                </androidx.appcompat.widget.Toolbar>

            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:behavior_overlapTop="70dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- Poster and Title Header -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardViewLoading"
                        android:layout_width="130dp"
                        android:layout_height="195dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <View
                            android:id="@+id/imagePosterDetailLoading"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/light_gray" />
                    </androidx.cardview.widget.CardView>

                    <View
                        android:id="@+id/nameDetailLoading"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="85dp"
                        android:background="@color/light_gray"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/cardViewLoading"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/textGenresDetailLoading"
                        android:layout_width="0dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/light_gray"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/nameDetailLoading"
                        app:layout_constraintTop_toBottomOf="@+id/nameDetailLoading" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/nameDetailLoading"
                        app:layout_constraintTop_toBottomOf="@+id/textGenresDetailLoading">

                        <View
                            android:layout_width="100dp"
                            android:layout_height="44dp"
                            android:background="@color/light_gray" />

                        <View
                            android:id="@+id/favBtnLoading"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:background="@color/light_gray" />

                        <View
                            android:id="@+id/WatchListBtnLoading"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:background="@color/light_gray" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Stats Highlight Bar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    app:cardBackgroundColor="#1AFFFFFF"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@color/light_gray" />

                            <View
                                android:id="@+id/textRatingDetailLoading"
                                android:layout_width="30dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="4dp"
                                android:background="@color/light_gray" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="#26FFFFFF" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@color/light_gray" />

                            <View
                                android:id="@+id/textTypeDetailLoading"
                                android:layout_width="40dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="4dp"
                                android:background="@color/light_gray" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="#26FFFFFF" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@color/light_gray" />

                            <View
                                android:id="@+id/textDateDetailLoading"
                                android:layout_width="40dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="4dp"
                                android:background="@color/light_gray" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="#26FFFFFF" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@color/light_gray" />

                            <View
                                android:id="@+id/textDurationLoading"
                                android:layout_width="40dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="4dp"
                                android:background="@color/light_gray" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Trailer Action Card placeholder -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginBottom="20dp"
                    android:background="@color/light_gray" />

                <!-- Overview Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <View
                        android:layout_width="100dp"
                        android:layout_height="24dp"
                        android:background="@color/light_gray" />

                    <View
                        android:id="@+id/textOverviewLoading"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/light_gray" />

                    <View
                        android:id="@+id/textLanguageDetailLoading"
                        android:layout_width="60dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/light_gray" />
                </LinearLayout>

                <!-- Seasons Section (TV Only) -->
                <LinearLayout
                    android:id="@+id/SeasonLayoutLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="100dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/light_gray" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/SeasonRecyclerLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp" />
                </LinearLayout>

                <!-- Cast Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="100dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/light_gray" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/castLayoutLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp" />
                </LinearLayout>

                <!-- Director Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/DirectorORCreatorLabelLoading"
                        android:layout_width="100dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/light_gray" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/directorLayoutLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
