<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/LogOutBtn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/component_bg"
            android:text="Log Out"
            android:textColor="@color/design_default_color_error"
            app:backgroundTint="@color/card_bg" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/LogOutPromph"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/black_overlay"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/fake_blur_bg"
            android:backgroundTint="@android:color/white"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="visible">

            <!-- 1. The Alert Title -->
            <TextView
                android:id="@+id/textView13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Log out of your account?"
                android:textAlignment="center"
                android:textColor="#1A1A1A"
                android:textSize="20sp" />

            <!-- 2. The Alert Body/Subtitle -->
            <TextView
                android:id="@+id/textView14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif"
                android:text="You will need to enter your credentials to log back in."
                android:textAlignment="center"
                android:textColor="#6C757D"
                android:textSize="14sp" />

            <!-- 3. Standard Button Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- DE-EMPHASIZED CANCEL BUTTON (Outlined Style) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/CancelBtn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textColor="#212529"
                    app:strokeColor="#E3E9EF" />

                <!-- HIGH CONTRAST ACTION BUTTON (Filled Destructive) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/LogOutBtnFinal"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Log Out"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#DC3545" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>